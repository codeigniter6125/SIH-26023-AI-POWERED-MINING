# Application Configuration
PROJECT_NAME="GeoMine AI Backend"
API_V1_STR="/api/v1"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/geomine_db"

# Vector Store
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# LLM Keys
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="optional-openai-api-key"

# Storage
STORAGE_DIR="./uploads"
